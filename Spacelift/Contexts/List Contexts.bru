meta {
  name: List Contexts
  type: graphql
  seq: 1
}

docs {
  List of all the contexts in the account.

  <!-- notes: hand-written, preserved by sync-docs -->

  Sets `{{contextId}}` to the first context in the response, which **Add Config**
  then uses without you copying anything.
}

post {
  url: {{SPACELIFT_ENDPOINT}}
  body: graphql
  auth: inherit
}

body:graphql {
  {
    contexts {
      id
      name
      description
      labels
      space
      createdAt
      updatedAt
    }
  }
}

vars:post-response {
  contextId: res.body.data.contexts?.[0]?.id
}

example {
  name: Example response
  description: Illustrative, generated from the schema — not captured from a live account. The shape and field names are exact; the values are placeholders.

  request: {
    url: {{SPACELIFT_ENDPOINT}}
    method: POST
    mode: graphql
    body:graphql: {
      {
        contexts {
          id
          name
          description
          labels
          space
          createdAt
          updatedAt
        }
      }
    }
  }

  response: {
    headers: {
      content-type: application/json
    }

    status: {
      code: 200
      text: OK
    }

    body: {
      type: json
      content: '''
        {
          "data": {
            "contexts": [
              {
                "id": "example-context",
                "name": "Example Context",
                "description": "Example Context description",
                "labels": [
                  "example-label"
                ],
                "space": "root",
                "createdAt": 1758000000,
                "updatedAt": 1758000000
              }
            ]
          }
        }
      '''
    }
  }
}
