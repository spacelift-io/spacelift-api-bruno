meta {
  name: List Contexts
  type: graphql
  seq: 1
}

docs {
  List of all the contexts in the account.

  <!-- notes: hand-written, preserved by sync-docs -->

  A context's `id` from this response is what **Add Config** asks for.
}

post {
  url: {{SPACELIFT_ENDPOINT}}
  body: graphql
  auth: inherit
}

body:graphql {
  {
    contexts {
      id
      name
      description
      labels
      space
      createdAt
      updatedAt
    }
  }
}
