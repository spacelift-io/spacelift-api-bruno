meta {
  name: List Contexts
  type: graphql
  seq: 1
}

docs {
  List of all the contexts in the account.

  <!-- notes: hand-written, preserved by sync-docs -->

  Sets `{{contextId}}` to the first context in the response, which **Add Config**
  then uses without you copying anything.
}

post {
  url: {{SPACELIFT_ENDPOINT}}
  body: graphql
  auth: inherit
}

body:graphql {
  {
    contexts {
      id
      name
      description
      labels
      space
      createdAt
      updatedAt
    }
  }
}

vars:post-response {
  contextId: res.body.data.contexts?.[0]?.id
}
