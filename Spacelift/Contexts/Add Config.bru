meta {
  name: Add Config
  type: graphql
  seq: 8
}

docs {
  Add a context config element. Requires 'Context Update' permission on the context Space.

  <!-- notes: hand-written, preserved by sync-docs -->

  **`config.type`** is either `ENVIRONMENT_VARIABLE` or `FILE_MOUNT`. For a file
  mount, `id` is the path the file is mounted at.

  Setting `writeOnly` to true means the value cannot be read back afterwards —
  right for secrets, and irreversible without replacing the entry.

  `context` comes from `{{contextId}}`, which **Contexts → List Contexts** sets.
}

post {
  url: {{SPACELIFT_ENDPOINT}}
  body: graphql
  auth: inherit
}

body:graphql {
  mutation AddContextConfig($context: ID!, $config: ConfigInput!) {
    contextConfigAdd(context: $context, config: $config) {
      id
      type
      value
      description
      writeOnly
      createdAt
    }
  }
}

body:graphql:vars {
  {
    "context": "{{contextId}}",
    "config": {
      "id": "MY_ENV_VAR",
      "type": "ENVIRONMENT_VARIABLE",
      "value": "my-value",
      "description": "My environment variable",
      "writeOnly": false
    }
  }
}
