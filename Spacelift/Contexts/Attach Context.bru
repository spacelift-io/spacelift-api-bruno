meta {
  name: Attach Context
  type: graphql
  seq: 6
}

docs {
  Attach context to a Stack.

  <!-- notes: hand-written, preserved by sync-docs -->

  **`priority`** orders this attachment against the stack's other contexts, which
  is what decides the winner when two of them set the same variable. Attaching a
  context a stack already has will fail rather than move it.
}

post {
  url: {{SPACELIFT_ENDPOINT}}
  body: graphql
  auth: inherit
}

body:graphql {
  mutation AttachContext($id: ID!, $stack: ID!, $priority: Int!) {
    contextAttach(id: $id, stack: $stack, priority: $priority) {
      id
      stackId
      stackName
      priority
      isModule
      isAutoattached
    }
  }
}

body:graphql:vars {
  {
    "id": "CONTEXT_ID_HERE",
    "stack": "STACK_ID_HERE",
    "priority": 1
  }
}
