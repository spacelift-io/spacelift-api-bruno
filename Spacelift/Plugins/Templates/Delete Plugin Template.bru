meta {
  name: Delete Plugin Template
  type: graphql
  seq: 4
}

docs {
  Delete an existing Plugin Template.
}

post {
  url: {{SPACELIFT_ENDPOINT}}
  body: graphql
  auth: inherit
}

body:graphql {
  mutation DeletePluginTemplate($id: ID!) {
    pluginTemplateDelete(id: $id) {
      id
      name
    }
  }
}

body:graphql:vars {
  {
    "id": "{{?Plugin Template ID}}"
  }
}
