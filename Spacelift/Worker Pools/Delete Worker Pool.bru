meta {
  name: Delete Worker Pool
  type: graphql
  seq: 5
}

docs {
  Delete an existing WorkerPool.
}

post {
  url: {{SPACELIFT_ENDPOINT}}
  body: graphql
  auth: inherit
}

body:graphql {
  mutation DeleteWorkerPool($id: ID!) {
    workerPoolDelete(id: $id) {
      id
      name
    }
  }
}

body:graphql:vars {
  {
    "id": "{{?Worker Pool ID}}"
  }
}
