meta {
  name: Create Blob Storage Integration
  type: graphql
  seq: 2
}

docs {
  Creates a Blob Storage integration.
}

post {
  url: {{SPACELIFT_ENDPOINT}}
  body: graphql
  auth: bearer
}

auth:bearer {
  token: {{jwt}}
}

body:graphql {
  mutation CreateBlobStorageIntegration($subtype: BlobStorageSubtype!, $authMethod: BlobStorageAuthMethod!, $baseURI: String!, $region: String) {
    blobStorageIntegrationCreate(subtype: $subtype, authMethod: $authMethod, baseURI: $baseURI, region: $region) {
      id
      subtype
      authMethod
      baseURI
      region
      endpoint
      roleArn
      accessKeyId
      hasCredentials
    }
  }
}

body:graphql:vars {
  {
    "subtype": "AWS_S3",
    "authMethod": "AWS_ROLE",
    "baseURI": "s3://my-bucket/prefix",
    "region": "eu-west-1"
  }
}
