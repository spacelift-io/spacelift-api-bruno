meta {
  name: Delete User Group Role Binding
  type: graphql
  seq: 5
}

post {
  url: {{SPACELIFT_ENDPOINT}}
  body: graphql
  auth: inherit
}

body:graphql {
  mutation DeleteUserGroupRoleBinding($id: ID!) {
    userGroupRoleBindingDelete(id: $id) {
      id
      roleID
    }
  }
}

body:graphql:vars {
  {
    "id": "{{?Role Binding ID}}"
  }
}
