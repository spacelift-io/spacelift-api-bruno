meta {
  name: Get Flows Integration
  type: graphql
  seq: 1
}

docs {
  Returns the Flows integration for the current account, if linked.
}

post {
  url: {{SPACELIFT_ENDPOINT}}
  body: graphql
  auth: bearer
}

auth:bearer {
  token: {{jwt}}
}

body:graphql {
  query GetFlowsIntegration {
    flowsIntegration {
      organizationID
      organizationName
      baseURL
      createdAt
      updatedAt
    }
  }
}

body:graphql:vars {
  {}
}
