meta {
  name: Unlock Tofu Workspace
  type: graphql
  seq: 3
}

docs {
  Unlock a single locked Tofu workspace.
}

post {
  url: {{SPACELIFT_ENDPOINT}}
  body: graphql
  auth: bearer
}

auth:bearer {
  token: {{jwt}}
}

body:graphql {
  mutation UnlockTofuWorkspace($id: ID!) {
    tofuWorkspaceUnlock(id: $id) {
      id
      name
      isLocked
      lockedBy
      createdAt
    }
  }
}

body:graphql:vars {
  {
    "id": "TOFU_WORKSPACE_ID_HERE"
  }
}
