meta {
  name: Create API Key
  type: graphql
  seq: 3
}

docs {
  Create an API key.

  <!-- notes: hand-written, preserved by sync-docs -->

  The response contains the key's secret, and it is the only time you will ever
  see it. Copy it before you close the response.

  A new key can do nothing until a role is bound to it — see
  **Roles → API Key Role Bindings**.
}

post {
  url: {{SPACELIFT_ENDPOINT}}
  body: graphql
  auth: inherit
}

body:graphql {
  mutation CreateApiKey($input: ApiKeyInput!) {
    apiKeyCreate(input: $input) {
      id
      name
      admin
      description
      isMachineUser
      expiresAt
      createdAt
    }
  }
}

body:graphql:vars {
  {
    "input": {
      "name": "my-api-key",
      "admin": false,
      "machine": true,
      "description": "My API key",
      "teams": [],
      "expiresAt": null
    }
  }
}
