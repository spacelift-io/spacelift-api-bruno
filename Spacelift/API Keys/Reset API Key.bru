meta {
  name: Reset API Key
  type: graphql
  seq: 7
}

docs {
  Reset the secret of an API key.
}

post {
  url: {{SPACELIFT_ENDPOINT}}
  body: graphql
  auth: inherit
}

body:graphql {
  mutation ResetApiKey($id: ID!) {
    apiKeyReset(id: $id) {
      id
      name
      type
      description
      createdAt
      expiresAt
      secret
    }
  }
}

body:graphql:vars {
  {
    "id": "{{?API Key ID}}"
  }
}
