auth {
  mode: bearer
}

auth:bearer {
  token: {{jwt}}
}

script:pre-request {
  // Keep a valid Spacelift JWT in the environment, minting one when it is
  // missing and replacing it shortly before it expires.
  //
  // Spacelift tokens last a few hours. Without this, the first request after
  // an expiry fails with an authentication error that says nothing about
  // tokens, and the fix — "go and re-send Auth → Get Token" — is something
  // you can only know by having been told.
  //
  // Uses axios directly rather than bru.runRequest("Auth/Get Token"): Bruno
  // documents that calling runRequest from a *collection-level* pre-request
  // script can recurse infinitely, since the request it runs triggers this
  // same script again.
  //
  // axios and atob are both available in Bruno's default Safe Mode, so this
  // needs no sandbox change.

  const axios = require("axios");
  const atob = require("atob");

  // Requests in "Danger Zone" destroy something and take no ID, so
  // destructive-prompts.js has no placeholder to turn into a prompt and Bruno's
  // runner has nothing to skip on. They are refused here instead, which also
  // stops a collection run from sending them.
  //
  // Written and verified by scripts/destructive-prompts.js — edit it there.
  const REQUIRES_CONFIRMATION = [
    "Account Confirm Delete",
    "Account Toggle Deletion Mark",
    "Billing Subscription Create",
    "Billing Subscription Delete",
    "Billing Subscription Update Tier",
    "Billing Subscription Update V2",
    "Clean Migration Queue",
    "Delete Audit Trail Webhook",
    "Delete Audit Trail Webhook Headers",
    "Delete Oauth Client For SCIM",
    "Delete Origin Integration",
    "Migrate Stacks",
    "Migrate Vendor For All Stacks",
    "Oidc Delete",
    "Oidc Update",
    "Reset Oauth Client For SCIM",
    "Saml Delete",
    "Saml Update",
    "Session Delete All",
    "Set Audit Trail Webhook Headers",
    "Slack App Config Delete",
    "Slack App Config Set",
    "Unlink Identity Federation",
    "Update Azure DevOps Integration",
    "Update Bitbucket Cloud Integration",
    "Update Bitbucket Datacenter Integration",
    "Update Blob Storage Integration",
    "Update GitHub Enterprise Integration",
    "Update GitLab Integration",
    "User Security Key Delete All",
  ];

  if (
    REQUIRES_CONFIRMATION.includes(req.getName()) &&
    bru.getEnvVar("CONFIRM_DESTRUCTIVE") !== req.getName()
  ) {
    throw new Error(
      `"${req.getName()}" destroys something and takes no ID, so nothing prompts ` +
        `before it runs. To send it, set CONFIRM_DESTRUCTIVE to exactly that name ` +
        `in the "my-account" environment, then clear it afterwards.`
    );
  }

  // These three manage the token themselves; running this first would mint a
  // token only to have them immediately replace or discard it.
  const MANAGES_ITS_OWN_TOKEN = ["Get Token", "Refresh Token", "Logout"];

  // Refresh this far ahead of expiry, so a token cannot lapse between the
  // check and the response coming back.
  const REFRESH_BEFORE_EXPIRY_MS = 120 * 1000;

  const GET_TOKEN = `
    mutation GetSpaceliftToken($apiKeyId: ID!, $apiKeySecret: String!) {
      apiKeyUser(id: $apiKeyId, secret: $apiKeySecret) {
        jwt
      }
    }
  `;

  /**
   * True if `token` is absent, malformed, or close enough to expiry to be
   * worth replacing.
   *
   * A token we cannot read is treated as unusable rather than assumed good:
   * being wrong in that direction costs one extra round trip, while the other
   * direction is the authentication error this script exists to prevent.
   */
  function needsRefresh(token) {
    if (!token) return true;

    const segments = String(token).split(".");
    if (segments.length !== 3) return true;

    try {
      // JWT payloads are base64url; atob expects plain base64.
      const base64 = segments[1].replace(/-/g, "+").replace(/_/g, "/");
      const padded = base64.padEnd(Math.ceil(base64.length / 4) * 4, "=");
      const { exp } = JSON.parse(atob(padded));

      if (typeof exp !== "number") return true;
      return exp * 1000 - Date.now() < REFRESH_BEFORE_EXPIRY_MS;
    } catch (err) {
      return true;
    }
  }

  if (!MANAGES_ITS_OWN_TOKEN.includes(req.getName()) && needsRefresh(bru.getEnvVar("jwt"))) {
    const endpoint = bru.getEnvVar("SPACELIFT_ENDPOINT");
    const apiKeyId = bru.getEnvVar("SPACELIFT_API_KEY_ID");
    const apiKeySecret = bru.getEnvVar("SPACELIFT_API_KEY_SECRET");

    // Name the missing field. Left to itself this surfaces as a connection
    // error against the literal string "myaccount", or as an unhelpful 401.
    const missing = [];
    if (!endpoint || endpoint.includes("myaccount.app.spacelift.io")) {
      missing.push("SPACELIFT_ENDPOINT");
    }
    if (!apiKeyId) missing.push("SPACELIFT_API_KEY_ID");
    if (!apiKeySecret) missing.push("SPACELIFT_API_KEY_SECRET");

    if (missing.length) {
      throw new Error(
        `Spacelift credentials are not set up yet. Fill in ${missing.join(", ")} ` +
          `in the "my-account" environment (top right), then send this request again. ` +
          `See the collection's Docs tab for where to find these values.`
      );
    }

    const response = await axios.post(
      endpoint,
      {
        query: GET_TOKEN,
        variables: { apiKeyId, apiKeySecret },
      },
      { headers: { "Content-Type": "application/json" } }
    );

    const jwt = response.data?.data?.apiKeyUser?.jwt;

    if (!jwt) {
      const reason =
        response.data?.errors?.map((e) => e.message).join("; ") ||
        "the API returned no token";
      throw new Error(
        `Could not authenticate with Spacelift: ${reason}. ` +
          `Check SPACELIFT_API_KEY_ID and SPACELIFT_API_KEY_SECRET in the "my-account" environment.`
      );
    }

    bru.setEnvVar("jwt", jwt);
    console.log("Spacelift token refreshed.");
  }
}

tests {
  // Runs after every request, in the app and under the CLI.
  //
  // The second assertion is the one that earns its place. GraphQL answers 200
  // even when the operation failed — the failure is an entry in the body's
  // `errors` array — so "stack not found" and "here is your stack" are the same
  // status code. Anyone judging a response by its status is reading the wrong
  // field, and the Tests tab now says so directly.

  test("responds 200", function () {
    expect(res.getStatus()).to.equal(200);
  });

  test("returns no GraphQL errors", function () {
    const errors = res.getBody()?.errors;
    expect(errors, errors ? JSON.stringify(errors) : "").to.equal(undefined);
  });
}

docs {
  # Spacelift API

  Every operation in the Spacelift GraphQL API, one request per operation.

  ## Start here

  1. Fill in `SPACELIFT_ENDPOINT`, `SPACELIFT_API_KEY_ID` and `SPACELIFT_API_KEY_SECRET` in the `my-account` environment (top-right dropdown).
  2. Send any request.

  There is no token step. The collection mints a token the first time it needs one and replaces it shortly before it expires, so authentication stays out of your way. **Auth → Get Token** is still there if you want one explicitly.

  See the [README](https://github.com/spacelift-io/spacelift-api-bruno#setup) for detailed setup instructions.

  ## What's New

  ✚ added · ✎ corrected · ⚠ deprecated · ✖ removed

  **2026-09-16**

  - ✎ Scans → Search Scans — `integration` moved onto `providerConfigs`; the API rejects it at the top level
  - ✎ Scans → Get Scan — `integration` moved onto `providerConfigs`; the API rejects it at the top level
  - ✎ Scans → Create Scan — `integration` now goes inside each `providerConfigs` entry, not at the top level
  - ✎ Scans → Update Scan — `integration` now goes inside each `providerConfigs` entry, not at the top level

  **2026-09-15**

  - ✖ Runs → Delete Run State Summary
  - ✖ Runs → Delete Run Summary
  - ✖ Runs → Summarize Run
  - ✖ Runs → Summarize Run State
  - ⚠ Blueprints → Deployments → List Deployments — Use searchTemplateDeployments instead
  - ⚠ Blueprints → Deployments → Get Deployment — Use templateDeployment instead
  - ⚠ Blueprints → Deployments → Create Deployment — Use templateDeploymentCreate instead
  - ⚠ Blueprints → Deployments → Update Deployment — Use templateDeploymentUpdate instead

  _… and 701 earlier changes — see the [full changelog](https://github.com/spacelift-io/spacelift-api-bruno/blob/main/CHANGELOG.md)._
}
