meta {
  name: Create External Integration
  type: graphql
  seq: 3
}

post {
  url: {{SPACELIFT_ENDPOINT}}
  body: graphql
  auth: inherit
}

body:graphql {
  mutation CreateExternalIntegration($input: ExternalIntegrationInput!) {
    externalIntegrationCreate(input: $input) {
      id
      name
      description
      type
      createdAt
    }
  }
}

body:graphql:vars {
  {
    "input": {
      "space": "root",
      "name": "my-external-integration",
      "description": "My external integration",
      "type": "CUSTOM",
      "customConfigData": {}
    }
  }
}
