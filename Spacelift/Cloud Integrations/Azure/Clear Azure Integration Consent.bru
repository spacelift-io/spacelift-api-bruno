meta {
  name: Clear Azure Integration Consent
  type: graphql
  seq: 12
}

docs {
  Clears Spacelift consent confirmation without revoking Azure permissions.
}

post {
  url: {{SPACELIFT_ENDPOINT}}
  body: graphql
  auth: inherit
}

body:graphql {
  mutation ClearAzureIntegrationConsent($id: ID!) {
    azureIntegrationConsentClear(id: $id) {
      adminConsentProvided
    }
  }
}

body:graphql:vars {
  {
    "id": "AZURE_INTEGRATION_ID_HERE"
  }
}
