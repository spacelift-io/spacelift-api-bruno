meta {
  name: Create Scan
  type: graphql
  seq: 3
}

docs {
  Create a new Scan configuration.

  <!-- notes: hand-written, preserved by sync-docs -->

  Send **List Scan Provider Schemas** first. It reports which providers can be
  scanned and what each one accepts; anything absent there cannot be scanned.

  ⚠ **`providerConfigs[].version`** is typed `String` but only accepts the values
  that request lists. A wrong one is rejected when the scan runs, not when you
  send this.
}

post {
  url: {{SPACELIFT_ENDPOINT}}
  body: graphql
  auth: inherit
}

body:graphql {
  mutation CreateScan($input: ScanInput!) {
    scanCreate(input: $input) {
      id
      name
      description
      labels
      space {
        id
      }
      workerPool
      providerConfigs {
        type
        integration
        integrationName
      }
      runnerImage
      createdAt
      updatedAt
    }
  }
}

body:graphql:vars {
  {
    "input": {
      "space": "SPACE_ID_HERE",
      "name": "example-scan",
      "description": "Example scan configuration",
      "labels": ["example"],
      "providerConfigs": [
        {
          "version": "6",
          "integration": "AWS_INTEGRATION_ID_HERE",
          "aws": {
            "region": "eu-west-1"
          }
        }
      ],
      "scope": [
        {
          "type": "aws_s3_bucket",
          "filters": [
            {
              "key": "region",
              "value": "eu-west-1"
            }
          ]
        }
      ],
      "workerPool": "WORKER_POOL_ID_HERE"
    }
  }
}
