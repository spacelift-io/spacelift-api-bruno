meta {
  name: Update Scan
  type: graphql
  seq: 4
}

docs {
  Update an existing Scan configuration.
}

post {
  url: {{SPACELIFT_ENDPOINT}}
  body: graphql
  auth: inherit
}

body:graphql {
  mutation UpdateScan($id: ID!, $input: ScanInput!) {
    scanUpdate(id: $id, input: $input) {
      id
      name
      description
      labels
      space {
        id
      }
      workerPool
      integration
      runnerImage
      createdAt
      updatedAt
    }
  }
}

body:graphql:vars {
  {
    "id": "SCAN_ID_HERE",
    "input": {
      "space": "SPACE_ID_HERE",
      "name": "example-scan",
      "description": "Updated scan configuration",
      "labels": ["example"],
      "providerConfigs": [
        {
          "version": "6",
          "aws": {
            "region": "eu-west-1"
          }
        }
      ],
      "scope": [
        {
          "type": "aws_s3_bucket",
          "filters": [
            {
              "key": "region",
              "value": "eu-west-1"
            }
          ]
        }
      ],
      "workerPool": "WORKER_POOL_ID_HERE",
      "integration": "AWS_INTEGRATION_ID_HERE"
    }
  }
}
