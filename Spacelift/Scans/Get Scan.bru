meta {
  name: Get Scan
  type: graphql
  seq: 2
}

docs {
  Details of a single Scan.
}

post {
  url: {{SPACELIFT_ENDPOINT}}
  body: graphql
  auth: inherit
}

body:graphql {
  query GetScan($id: ID!) {
    scan(id: $id) {
      id
      name
      description
      labels
      space {
        id
      }
      workerPool
      providerConfigs {
        type
        integration
        integrationName
      }
      runnerImage
      createdAt
      updatedAt
      latestRun {
        id
        state
      }
    }
  }
}

body:graphql:vars {
  {
    "id": "SCAN_ID_HERE"
  }
}
