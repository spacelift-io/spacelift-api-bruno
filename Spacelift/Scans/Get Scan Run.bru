meta {
  name: Get Scan Run
  type: graphql
  seq: 7
}

docs {
  Details of a single ScanRun.
}

post {
  url: {{SPACELIFT_ENDPOINT}}
  body: graphql
  auth: inherit
}

body:graphql {
  query GetScanRun($id: ID!) {
    scanRun(id: $id) {
      id
      state
      resourceCount
      resourceStats {
        managed
        unmanaged
      }
      note
      stateChangedAt
      createdAt
      scan {
        id
        name
      }
    }
  }
}

body:graphql:vars {
  {
    "id": "SCAN_RUN_ID_HERE"
  }
}
