vars:secret [
  @description("Your account's GraphQL endpoint, like https://acme.app.spacelift.io/graphql. Self-hosted installations use their own hostname.")
  SPACELIFT_ENDPOINT,
  @description('The ID of your API key, shown when you create it under Settings → API Keys.')
  SPACELIFT_API_KEY_ID,
  @description('The secret for your API key. Shown only once, at creation.')
  SPACELIFT_API_KEY_SECRET,
  @description('Arms one Danger Zone request. Set it to the exact name of the request you want to send, then clear it afterwards. Leave empty otherwise.')
  CONFIRM_DESTRUCTIVE,
  @description('Filled in automatically. The collection mints and refreshes this for you; you never need to set it by hand.')
  jwt
]
