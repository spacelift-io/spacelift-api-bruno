meta {
  name: List Contexts
  type: graphql
  seq: 1
}

docs {
  List of all the contexts in the account.

  <!-- notes: hand-written, preserved by sync-docs -->

  Copy the `id` of the context you want into **Add Config**.
}

post {
  url: {{SPACELIFT_ENDPOINT}}
  body: graphql
  auth: inherit
}

body:graphql {
  {
    contexts {
      id
      name
      space
    }
  }
}
