meta {
  name: Attach Policy
  type: graphql
  seq: 3
}

docs {
  Attach Policy to a Stack.

  <!-- notes: hand-written, preserved by sync-docs -->

  `id` is the policy ID from **List Policies**, `stack` the stack ID from
  **List Stacks**.
}

post {
  url: {{SPACELIFT_ENDPOINT}}
  body: graphql
  auth: inherit
}

body:graphql {
  mutation AttachPolicy($id: ID!, $stack: ID!) {
    policyAttach(id: $id, stack: $stack) {
      id
      stackId
      stackName
    }
  }
}

body:graphql:vars {
  {
    "id": "POLICY_ID_HERE",
    "stack": "STACK_ID_HERE"
  }
}
