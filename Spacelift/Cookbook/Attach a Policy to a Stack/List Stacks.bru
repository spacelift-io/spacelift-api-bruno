meta {
  name: List Stacks
  type: graphql
  seq: 2
}

docs {
  List of all the stacks in the account.

  <!-- notes: hand-written, preserved by sync-docs -->

  Copy the `id` of the stack you want into **Attach Policy**.
}

post {
  url: {{SPACELIFT_ENDPOINT}}
  body: graphql
  auth: inherit
}

body:graphql {
  {
    stacks {
      id
      name
      space
    }
  }
}
