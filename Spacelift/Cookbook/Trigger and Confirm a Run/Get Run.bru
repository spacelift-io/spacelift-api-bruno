meta {
  name: Get Run
  type: graphql
  seq: 3
}

docs {
  Details of a single Run by ID, without needing to know the stack.

  <!-- notes: hand-written, preserved by sync-docs -->

  `id` is the run ID from **Trigger Run**. Send this again until `state` is
  `UNCONFIRMED`: the plan is done and waiting for you. `delta` counts what
  applying it would add, change and delete.

  If `canConfirm` is false, `confirmBlocker` says why.
}

post {
  url: {{SPACELIFT_ENDPOINT}}
  body: graphql
  auth: inherit
}

body:graphql {
  query GetRun($id: ID!) {
    run(id: $id) {
      id
      state
      canConfirm
      confirmBlocker
      delta {
        addCount
        changeCount
        deleteCount
      }
    }
  }
}

body:graphql:vars {
  {
    "id": "RUN_ID_HERE"
  }
}
