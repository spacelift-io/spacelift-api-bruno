meta {
  name: Delete Deployment
  type: graphql
  seq: 5
}

docs {
  ⚠ **DEPRECATED** — Use templateDeploymentDelete instead

  Delete a blueprint deployment
}

post {
  url: {{SPACELIFT_ENDPOINT}}
  body: graphql
  auth: inherit
}

body:graphql {
  mutation DeleteBlueprintDeployment($id: ID!, $blueprintID: ID!) {
    blueprintDeploymentDelete(id: $id, blueprintID: $blueprintID) {
      id
      name
    }
  }
}

body:graphql:vars {
  {
    "id": "{{?Deployment ID}}",
    "blueprintID": "{{?Blueprint ID}}"
  }
}
