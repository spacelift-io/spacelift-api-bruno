meta {
  name: Parse Blueprint Version Template
  type: graphql
  seq: 7
}

docs {
  ⚠ **DEPRECATED** — Use the templateVersionParseTemplate query instead
}

post {
  url: {{SPACELIFT_ENDPOINT}}
  body: graphql
  auth: inherit
}

body:graphql {
  mutation ParseBlueprintVersionTemplate($template: String!) {
    blueprintVersionParseTemplate(template: $template) {
      inputs {
        id
        name
        description
        type
      }
      errors
    }
  }
}

body:graphql:vars {
  {
    "template": "{}"
  }
}
