meta {
  name: Update Version
  type: graphql
  seq: 4
}

docs {
  ⚠ **DEPRECATED** — Use templateVersionUpdate instead
}

post {
  url: {{SPACELIFT_ENDPOINT}}
  body: graphql
  auth: inherit
}

body:graphql {
  mutation UpdateBlueprintVersion($id: ID!, $input: BlueprintVersionUpdateInput!) {
    blueprintVersionUpdate(id: $id, input: $input) {
      id
      name
      description
      state
    }
  }
}

body:graphql:vars {
  {
    "id": "VERSION_ID_HERE",
    "input": {
      "state": "PUBLISHED",
      "instructions": "How to use this blueprint",
      "labels": [],
      "template": "your-template-content-here",
      "versionNumber": "1.0.1"
    }
  }
}
