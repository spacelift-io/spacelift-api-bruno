meta {
  name: Create Version
  type: graphql
  seq: 3
}

docs {
  ⚠ **DEPRECATED** — Use templateVersionCreate instead
}

post {
  url: {{SPACELIFT_ENDPOINT}}
  body: graphql
  auth: inherit
}

body:graphql {
  mutation CreateBlueprintVersion($input: BlueprintVersionCreateInput!) {
    blueprintVersionCreate(input: $input) {
      id
      name
      description
      state
      createdAt
    }
  }
}

body:graphql:vars {
  {
    "input": {
      "blueprintID": "BLUEPRINT_ID_HERE",
      "state": "DRAFT",
      "instructions": "How to use this blueprint",
      "labels": [],
      "template": "your-template-content-here",
      "versionNumber": "1.0.0"
    }
  }
}
