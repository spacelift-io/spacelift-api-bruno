meta {
  name: Saml Update
  type: graphql
  seq: 18
}

docs {
  ℹ **ADVANCED** — Account-level SSO, SAML, SCIM or OIDC configuration.

  Update SAML settings to change claim mappings.
}

post {
  url: {{SPACELIFT_ENDPOINT}}
  body: graphql
  auth: inherit
}

body:graphql {
  mutation SamlUpdate($input: SAMLUpdateInput!) {
    samlUpdate(input: $input) {
      adminLogin
      idpMetadata
      idpMetadataURL
      nameIDFormat
    }
  }
}

body:graphql:vars {
  {
    "input": {}
  }
}
