meta {
  name: Set Audit Trail Webhook Headers
  type: graphql
  seq: 20
}

post {
  url: {{SPACELIFT_ENDPOINT}}
  body: graphql
  auth: inherit
}

body:graphql {
  mutation SetAuditTrailWebhookHeaders($input: AuditTrailWebhookSetHeadersInput!) {
    auditTrailWebhookSetHeaders(input: $input) {
      enabled
      endpoint
    }
  }
}

body:graphql:vars {
  {
    "input": {
      "customHeaders": {
        "entries": [
          {
            "key": "X-Custom-Header",
            "value": "header-value"
          }
        ]
      }
    }
  }
}
