meta {
  name: Delete Template
  type: graphql
  seq: 5
}

post {
  url: {{SPACELIFT_ENDPOINT}}
  body: graphql
  auth: bearer
}

auth:bearer {
  token: {{jwt}}
}

body:graphql {
  mutation DeleteTemplate($id: ID!) {
    templateDelete(id: $id) {
      id
      name
    }
  }
}

body:graphql:vars {
  {
    "id": "TEMPLATE_ID_HERE"
  }
}
