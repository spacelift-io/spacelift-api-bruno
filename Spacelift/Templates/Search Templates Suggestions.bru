meta {
  name: Search Templates Suggestions
  type: graphql
  seq: 7
}

docs {
  ℹ **ADVANCED** — Autocomplete helper that powers search filters in the UI.
}

post {
  url: {{SPACELIFT_ENDPOINT}}
  body: graphql
  auth: bearer
}

auth:bearer {
  token: {{jwt}}
}

body:graphql {
  query SearchTemplatesSuggestions($input: SearchSuggestionsInput!) {
    searchTemplatesSuggestions(input: $input) {
      filteredCount
      fields {
        name
        orderable
        filterable
        type
      }
    }
  }
}

body:graphql:vars {
  {
    "input": {
      "fields": []
    }
  }
}
