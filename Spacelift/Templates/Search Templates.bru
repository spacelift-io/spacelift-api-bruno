meta {
  name: Search Templates
  type: graphql
  seq: 1
}

post {
  url: {{SPACELIFT_ENDPOINT}}
  body: graphql
  auth: bearer
}

auth:bearer {
  token: {{jwt}}
}

body:graphql {
  query SearchTemplates($input: SearchInput!) {
    searchTemplates(input: $input) {
      edges {
        node {
          id
          name
          description
          labels
          space {
            id
          }
          createdAt
          updatedAt
          deploymentsCount
        }
      }
      pageInfo {
        hasNextPage
        endCursor
      }
    }
  }
}

body:graphql:vars {
  {
    "input": {
      "first": 50
    }
  }
}
