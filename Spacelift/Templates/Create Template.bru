meta {
  name: Create Template
  type: graphql
  seq: 3
}

post {
  url: {{SPACELIFT_ENDPOINT}}
  body: graphql
  auth: inherit
}

body:graphql {
  mutation CreateTemplate($input: TemplateCreateInput!) {
    templateCreate(input: $input) {
      id
      name
      description
      labels
      space {
        id
      }
      createdAt
      updatedAt
      deploymentsCount
    }
  }
}

body:graphql:vars {
  {
    "input": {
      "space": "SPACE_ID_HERE",
      "name": "example-template",
      "description": "Example template",
      "labels": ["example"]
    }
  }
}
