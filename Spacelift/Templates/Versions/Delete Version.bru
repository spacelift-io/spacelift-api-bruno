meta {
  name: Delete Version
  type: graphql
  seq: 3
}

post {
  url: {{SPACELIFT_ENDPOINT}}
  body: graphql
  auth: inherit
}

body:graphql {
  mutation DeleteTemplateVersion($id: ID!) {
    templateVersionDelete(id: $id) {
      id
      version
    }
  }
}

body:graphql:vars {
  {
    "id": "{{?Template Version ID}}"
  }
}
