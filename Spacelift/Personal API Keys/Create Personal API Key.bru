meta {
  name: Create Personal API Key
  type: graphql
  seq: 1
}

post {
  url: {{SPACELIFT_ENDPOINT}}
  body: graphql
  auth: inherit
}

body:graphql {
  mutation CreatePersonalApiKey($input: PersonalApiKeyInput!) {
    personalApiKeyCreate(input: $input) {
      id
      name
      type
      description
      createdAt
      expiresAt
      secret
    }
  }
}

body:graphql:vars {
  {
    "input": {
      "name": "example-personal-key",
      "description": "Created via the API"
    }
  }
}
