meta {
  name: Delete AI Integration
  type: graphql
  seq: 5
}

docs {
  Delete an AI integration.
}

post {
  url: {{SPACELIFT_ENDPOINT}}
  body: graphql
  auth: inherit
}

body:graphql {
  mutation DeleteAIIntegration($id: ID!) {
    aiIntegrationDelete(id: $id) {
      id
      name
    }
  }
}

body:graphql:vars {
  {
    "id": "{{?AI Integration ID}}"
  }
}
