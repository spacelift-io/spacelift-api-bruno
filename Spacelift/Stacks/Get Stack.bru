        {
          "data": {
            "stack": {
              "id": "example-stack",
              "name": "Example Stack",
              "description": "Example Stack description",
              "space": "root",
              "repository": "example-org/example-repo",
              "branch": "main",
              "projectRoot": "terraform/production",
              "administrative": true,
              "autodeploy": true,
              "labels": [
                "example-label"
              ]
            }
          }
        }
      '''
    }
  }
}
