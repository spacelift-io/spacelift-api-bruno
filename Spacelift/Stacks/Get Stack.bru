meta {
  name: Get Stack
  type: graphql
  seq: 2
}

docs {
  Details of a single Stack.

  <!-- notes: hand-written, preserved by sync-docs -->

  `id` is a stack ID. **Stacks → List Stacks** lists them.
}

post {
  url: {{SPACELIFT_ENDPOINT}}
  body: graphql
  auth: inherit
}

body:graphql {
  query GetStack($id: ID!) {
    stack(id: $id) {
      id
      name
      description
      space
      repository
      branch
      projectRoot
      administrative
      autodeploy
      labels
    }
  }
}

body:graphql:vars {
  {
    "id": "STACK_ID_HERE"
  }
}
