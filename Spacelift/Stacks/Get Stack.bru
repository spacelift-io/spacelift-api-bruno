meta {
  name: Get Stack
  type: graphql
  seq: 2
}

docs {
  Details of a single Stack.

  <!-- notes: hand-written, preserved by sync-docs -->

  Takes `id` from `{{stackId}}`, which **Stacks → List Stacks** sets. Replace it with
  a literal ID for a specific stack.
}

post {
  url: {{SPACELIFT_ENDPOINT}}
  body: graphql
  auth: inherit
}

body:graphql {
  query GetStack($id: ID!) {
    stack(id: $id) {
      id
      name
      description
      space
      repository
      branch
      projectRoot
      administrative
      autodeploy
      labels
    }
  }
}

body:graphql:vars {
  {
    "id": "{{stackId}}"
  }
}

example {
  name: Example response
  description: Illustrative, generated from the schema — not captured from a live account. The shape and field names are exact; the values are placeholders.

  request: {
    url: {{SPACELIFT_ENDPOINT}}
    method: POST
    mode: graphql
    body:graphql: {
      query GetStack($id: ID!) {
        stack(id: $id) {
          id
          name
          description
          space
          repository
          branch
          projectRoot
          administrative
          autodeploy
          labels
        }
      }
    }

    body:graphql:vars: {
      {
        "id": "{{stackId}}"
      }
    }
  }

  response: {
    headers: {
      content-type: application/json
    }

