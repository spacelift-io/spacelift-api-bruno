meta {
  name: List Stacks
  type: graphql
  seq: 1
}

docs {
  List of all the stacks in the account.

  <!-- notes: hand-written, preserved by sync-docs -->

  Sets `{{stackId}}` to the first stack in the response, so **Get Stack**,
  **Trigger Run** and **Attach Policy** work straight after this without copying an
  ID by hand. Send this first, then open one of those.
}

post {
  url: {{SPACELIFT_ENDPOINT}}
  body: graphql
  auth: inherit
}

body:graphql {
  {
    stacks {
      id
      name
      description
      space
      repository
      branch
      projectRoot
      administrative
      autodeploy
      labels
    }
  }
}

vars:post-response {
  stackId: res.body.data.stacks?.[0]?.id
}

example {
  name: Example response
  description: Illustrative, generated from the schema — not captured from a live account. The shape and field names are exact; the values are placeholders.

  request: {
    url: {{SPACELIFT_ENDPOINT}}
    method: POST
    mode: graphql
    body:graphql: {
      {
        stacks {
          id
          name
          description
          space
          repository
          branch
          projectRoot
          administrative
          autodeploy
          labels
        }
      }
    }
  }

  response: {
    headers: {
      content-type: application/json
    }

    status: {
      code: 200
      text: OK
    }

    body: {
      type: json
      content: '''
        {
          "data": {
            "stacks": [
              {
                "id": "example-stack",
                "name": "Example Stack",
                "description": "Example Stack description",
                "space": "root",
                "repository": "example-org/example-repo",
                "branch": "main",
                "projectRoot": "terraform/production",
                "administrative": true,
                "autodeploy": true,
                "labels": [
                  "example-label"
                ]
              }
            ]
          }
        }
      '''
    }
  }
}
