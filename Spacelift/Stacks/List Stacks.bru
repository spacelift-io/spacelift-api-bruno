meta {
  name: List Stacks
  type: graphql
  seq: 1
}

docs {
  List of all the stacks in the account.

  <!-- notes: hand-written, preserved by sync-docs -->

  Sets `{{stackId}}` to the first stack in the response, so **Get Stack**,
  **Trigger Run** and **Attach Policy** work straight after this without copying an
  ID by hand. Send this first, then open one of those.
}

post {
  url: {{SPACELIFT_ENDPOINT}}
  body: graphql
  auth: inherit
}

body:graphql {
  {
    stacks {
      id
      name
      description
      space
      repository
      branch
      projectRoot
      administrative
      autodeploy
      labels
    }
  }
}

vars:post-response {
  stackId: res.body.data.stacks?.[0]?.id
}
