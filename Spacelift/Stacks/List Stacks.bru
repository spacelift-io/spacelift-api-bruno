meta {
  name: List Stacks
  type: graphql
  seq: 1
}

docs {
  List of all the stacks in the account.

  <!-- notes: hand-written, preserved by sync-docs -->

  Each stack's `id` is what **Get Stack**, **Trigger Run** and **Attach Policy**
  ask for. Copy the one you want out of the response.
}

post {
  url: {{SPACELIFT_ENDPOINT}}
  body: graphql
  auth: inherit
}

body:graphql {
  {
    stacks {
      id
      name
      description
      space
      repository
      branch
      projectRoot
      administrative
      autodeploy
      labels
    }
  }
}
