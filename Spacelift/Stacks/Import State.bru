meta {
  name: Import State
  type: graphql
  seq: 14
}

docs {
  Import a previously uploaded state file into a managed-state stack.
  NOTE: the `state` argument is the objectId returned by the stateUploadUrl
  mutation, which points at the file you uploaded via its pre-signed URL.
}

post {
  url: {{SPACELIFT_ENDPOINT}}
  body: graphql
  auth: inherit
}

body:graphql {
  mutation ImportState($stackId: ID!, $state: String!) {
    stackManagedStateImport(stackId: $stackId, state: $state)
  }
}

body:graphql:vars {
  {
    "stackId": "STACK_ID_HERE",
    "state": "BASE64_ENCODED_STATE_HERE"
  }
}
