meta {
  name: Publish Provider Version
  type: graphql
  seq: 11
}

docs {
  Publish an existing Terraform provider version.

  <!-- notes: hand-written, preserved by sync-docs -->

  Publishing is the last step, not the first. The version needs its platforms
  registered — one **Register Platform** per OS/architecture — before this will
  produce something installable.
}

post {
  url: {{SPACELIFT_ENDPOINT}}
  body: graphql
  auth: inherit
}

body:graphql {
  mutation PublishTerraformProviderVersion($version: ID!) {
    terraformProviderVersionPublish(version: $version) {
      id
      number
      status
    }
  }
}

body:graphql:vars {
  {
    "version": "PROVIDER_VERSION_ID_HERE"
  }
}
