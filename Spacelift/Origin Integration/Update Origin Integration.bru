meta {
  name: Update Origin Integration
  type: graphql
  seq: 3
}

docs {
  Updates the built-in Origin (Cursor) integration.
}

post {
  url: {{SPACELIFT_ENDPOINT}}
  body: graphql
  auth: inherit
}

body:graphql {
  mutation UpdateOriginIntegration($vcsChecks: VCSCheck!) {
    originIntegrationUpdate(vcsChecks: $vcsChecks) {
      vcsChecks
      useGitCheckout
      installationTarget
      repoSelectionMode
      scopes
    }
  }
}

body:graphql:vars {
  {
    "vcsChecks": "INDIVIDUAL"
  }
}
