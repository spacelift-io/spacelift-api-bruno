meta {
  name: Get Origin Integration
  type: graphql
  seq: 1
}

docs {
  Built-in Origin (Cursor) integration settings. Null when the Origin app is
  not installed on the account.
}

post {
  url: {{SPACELIFT_ENDPOINT}}
  body: graphql
  auth: inherit
}

body:graphql {
  query GetOriginIntegration {
    originIntegration {
      vcsChecks
      useGitCheckout
      installationTarget
      repoSelectionMode
      scopes
    }
  }
}

body:graphql:vars {
  {}
}
