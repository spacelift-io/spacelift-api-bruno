meta {
  name: Unlink Identity Federation
  type: graphql
  seq: 9
}

docs {
  Unlink an external provider from the current user's identity.
}

post {
  url: {{SPACELIFT_ENDPOINT}}
  body: graphql
  auth: inherit
}

body:graphql {
  mutation IdentityFederationUnlink($provider: FederationProvider!) {
    identityFederationUnlink(provider: $provider) {
      id
    }
  }
}

body:graphql:vars {
  {
    "provider": "GITHUB_OAUTH"
  }
}
