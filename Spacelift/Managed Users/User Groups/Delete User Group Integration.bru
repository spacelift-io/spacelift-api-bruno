meta {
  name: Delete User Group Integration
  type: graphql
  seq: 10
}

post {
  url: {{SPACELIFT_ENDPOINT}}
  body: graphql
  auth: inherit
}

body:graphql {
  mutation DeleteUserGroupIntegration($id: ID!) {
    managedUserGroupIntegrationDelete(id: $id) {
      id
      integrationName
    }
  }
}

body:graphql:vars {
  {
    "id": "{{?User Group Integration ID}}"
  }
}
