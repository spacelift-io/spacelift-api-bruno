meta {
  name: Invite Managed User
  type: graphql
  seq: 3
}

post {
  url: {{SPACELIFT_ENDPOINT}}
  body: graphql
  auth: inherit
}

body:graphql {
  mutation InviteManagedUser($input: ManagedUserInviteInputV2!) {
    managedUserInviteV2(input: $input) {
      id
      username
      invitationEmail
      status
    }
  }
}

body:graphql:vars {
  {
    "input": {
      "invitationEmail": "user@example.com",
      "username": "myuser",
      "roleBindings": [
        {
          "roleID": "ROLE_ID_HERE",
          "spaceID": "root"
        }
      ]
    }
  }
}
