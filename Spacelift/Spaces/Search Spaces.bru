meta {
  name: Search Spaces
  type: graphql
  seq: 9
}

docs {
  Search Spaces with a set of predicates, ordering and paging.
}

post {
  url: {{SPACELIFT_ENDPOINT}}
  body: graphql
  auth: inherit
}

body:graphql {
  query SearchSpaces($input: SearchInput!) {
    searchSpaces(input: $input) {
      edges {
        node {
          id
          name
          description
          labels
          parentSpace
        }
      }
      pageInfo {
        hasNextPage
        endCursor
      }
    }
  }
}

body:graphql:vars {
  {
    "input": {
      "first": 50
    }
  }
}
