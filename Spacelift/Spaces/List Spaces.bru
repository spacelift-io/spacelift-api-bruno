meta {
  name: List Spaces
  type: graphql
  seq: 1
}

docs {
  Details of all the spaces in the Account accessible for the user.
}

post {
  url: {{SPACELIFT_ENDPOINT}}
  body: graphql
  auth: inherit
}

body:graphql {
  {
    spaces {
      id
      name
      description
      parentSpace
      inheritEntities
      labels
    }
  }
}

example {
  name: Example response
  description: Illustrative, generated from the schema — not captured from a live account. The shape and field names are exact; the values are placeholders.

  request: {
    url: {{SPACELIFT_ENDPOINT}}
    method: POST
    mode: graphql
    body:graphql: {
      {
        spaces {
          id
          name
          description
          parentSpace
          inheritEntities
          labels
        }
      }
    }
  }

  response: {
    headers: {
      content-type: application/json
    }

    status: {
      code: 200
      text: OK
    }

    body: {
      type: json
      content: '''
        {
          "data": {
            "spaces": [
              {
                "id": "example-space",
                "name": "Example Space",
                "description": "Example Space description",
                "parentSpace": "example-parentspace",
                "inheritEntities": true,
                "labels": [
                  "example-label"
                ]
              }
            ]
          }
        }
      '''
    }
  }
}
