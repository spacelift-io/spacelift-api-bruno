meta {
  name: Attach Policy
  type: graphql
  seq: 6
}

docs {
  Attach Policy to a Stack.

  <!-- notes: hand-written, preserved by sync-docs -->

  Takes both IDs from the variables **List Policies** and **List Stacks** set. Send
  those two first, then this — no copying between them.
}

post {
  url: {{SPACELIFT_ENDPOINT}}
  body: graphql
  auth: inherit
}

body:graphql {
  mutation AttachPolicy($id: ID!, $stack: ID!) {
    policyAttach(id: $id, stack: $stack) {
      id
      stackId
      stackName
      isModule
      isAutoattached
    }
  }
}

body:graphql:vars {
  {
    "id": "{{policyId}}",
    "stack": "{{stackId}}"
  }
}
