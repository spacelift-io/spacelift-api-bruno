meta {
  name: List Policies
  type: graphql
  seq: 1
}

docs {
  List of all the polices in the account.

  <!-- notes: hand-written, preserved by sync-docs -->

  Sets `{{policyId}}` to the first policy in the response, which **Attach Policy**
  then uses without you copying anything.
}

post {
  url: {{SPACELIFT_ENDPOINT}}
  body: graphql
  auth: inherit
}

body:graphql {
  {
    policies {
      id
      name
      body
      type
      description
      labels
      space
      createdAt
      updatedAt
    }
  }
}

vars:post-response {
  policyId: res.body.data.policies?.[0]?.id
}
