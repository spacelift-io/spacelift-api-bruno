meta {
  name: List Policies
  type: graphql
  seq: 1
}

docs {
  List of all the polices in the account.

  <!-- notes: hand-written, preserved by sync-docs -->

  A policy's `id` from this response is what **Attach Policy** asks for.
}

post {
  url: {{SPACELIFT_ENDPOINT}}
  body: graphql
  auth: inherit
}

body:graphql {
  {
    policies {
      id
      name
      body
      type
      description
      labels
      space
      createdAt
      updatedAt
    }
  }
}
