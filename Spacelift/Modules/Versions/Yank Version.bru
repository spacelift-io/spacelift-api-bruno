meta {
  name: Yank Version
  type: graphql
  seq: 5
}

docs {
  Yank the version (mark it as bad). This action cannot be undone.

  <!-- notes: hand-written, preserved by sync-docs -->

  Yanking is not deleting. The version stays resolvable for anything already
  pinned to it, and is hidden from new consumers. Use this rather than **Delete
  Version** when the version is out in the world.
}

post {
  url: {{SPACELIFT_ENDPOINT}}
  body: graphql
  auth: inherit
}

body:graphql {
  mutation YankModuleVersion($id: ID!, $module: ID!, $note: String) {
    versionYank(id: $id, module: $module, note: $note) {
      id
      number
      state
      yanked
      yankNote
    }
  }
}

body:graphql:vars {
  {
    "id": "{{?Version ID}}",
    "module": "{{?Module ID}}",
    "note": "Critical bug found"
  }
}
