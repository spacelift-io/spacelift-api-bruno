meta {
  name: Search Contexts Suggestions
  type: graphql
  seq: 10
}

docs {
  ℹ **ADVANCED** — Autocomplete helper that powers search filters in the UI.
}

post {
  url: {{SPACELIFT_ENDPOINT}}
  body: graphql
  auth: inherit
}

body:graphql {
  query SearchContextsSuggestions($input: SearchSuggestionsInput!) {
    searchContextsSuggestions(input: $input) {
      filteredCount
      fields {
        name
        orderable
        filterable
        type
      }
    }
  }
}

body:graphql:vars {
  {
    "input": {}
  }
}
