meta {
  name: Search Blueprint Versioned Groups Suggestions
  type: graphql
  seq: 8
}

docs {
  ⚠ **DEPRECATED** — Use searchTemplatesSuggestions instead

  ℹ **ADVANCED** — Autocomplete helper that powers search filters in the UI.
}

post {
  url: {{SPACELIFT_ENDPOINT}}
  body: graphql
  auth: inherit
}

body:graphql {
  query SearchBlueprintVersionedGroupsSuggestions($input: SearchSuggestionsInput!) {
    searchBlueprintVersionedGroupsSuggestions(input: $input) {
      filteredCount
      fields {
        name
        orderable
        filterable
        type
      }
    }
  }
}

body:graphql:vars {
  {
    "input": {}
  }
}
