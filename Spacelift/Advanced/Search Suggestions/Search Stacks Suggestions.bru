meta {
  name: Search Stacks Suggestions
  type: graphql
  seq: 27
}

docs {
  ℹ **ADVANCED** — Autocomplete helper that powers search filters in the UI.

  Information about fields available for searching Stacks.
}

post {
  url: {{SPACELIFT_ENDPOINT}}
  body: graphql
  auth: bearer
}

auth:bearer {
  token: {{jwt}}
}

body:graphql {
  query SearchStacksSuggestions($input: SearchSuggestionsInput!) {
    searchStacksSuggestions(input: $input) {
      filteredCount
      fields {
        name
        orderable
        filterable
        type
      }
    }
  }
}

body:graphql:vars {
  {
    "input": {}
  }
}
