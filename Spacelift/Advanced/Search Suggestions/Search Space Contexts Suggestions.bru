meta {
  name: Search Space Contexts Suggestions
  type: graphql
  seq: 24
}

docs {
  ℹ **ADVANCED** — Autocomplete helper that powers search filters in the UI.

  Filter-dropdown suggestions scoped to the given space's contexts.
}

post {
  url: {{SPACELIFT_ENDPOINT}}
  body: graphql
  auth: inherit
}

body:graphql {
  query SearchSpaceContextsSuggestions($space: ID!, $input: SearchSuggestionsInput!) {
    searchSpaceContextsSuggestions(space: $space, input: $input) {
      filteredCount
      fields {
        name
        orderable
        filterable
        type
      }
    }
  }
}

body:graphql:vars {
  {
    "space": "SPACE_ID_HERE",
    "input": {}
  }
}
