meta {
  name: Search Repos Suggestions
  type: graphql
  seq: 21
}

docs {
  ℹ **ADVANCED** — Autocomplete helper that powers search filters in the UI.

  Get field suggestions for Repo search
}

post {
  url: {{SPACELIFT_ENDPOINT}}
  body: graphql
  auth: inherit
}

body:graphql {
  query SearchReposSuggestions($input: SearchSuggestionsInput!) {
    searchReposSuggestions(input: $input) {
      filteredCount
      fields {
        name
        orderable
        filterable
        type
      }
    }
  }
}

body:graphql:vars {
  {
    "input": {}
  }
}
