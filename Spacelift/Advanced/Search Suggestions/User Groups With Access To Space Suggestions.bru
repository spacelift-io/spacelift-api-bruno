meta {
  name: User Groups With Access To Space Suggestions
  type: graphql
  seq: 32
}

docs {
  ℹ **ADVANCED** — Autocomplete helper that powers search filters in the UI.

  Returns the available search fields and their possible values for userGroupsWithAccessToSpace.
}

post {
  url: {{SPACELIFT_ENDPOINT}}
  body: graphql
  auth: inherit
}

body:graphql {
  query UserGroupsWithAccessToSpaceSuggestions($space: ID!, $input: SearchSuggestionsInput!) {
    userGroupsWithAccessToSpaceSuggestions(space: $space, input: $input) {
      filteredCount
      fields {
        name
        orderable
        filterable
        type
      }
    }
  }
}

body:graphql:vars {
  {
    "space": "SPACE_ID_HERE",
    "input": {}
  }
}
