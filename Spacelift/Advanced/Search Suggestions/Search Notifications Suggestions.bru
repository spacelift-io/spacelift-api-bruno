meta {
  name: Search Notifications Suggestions
  type: graphql
  seq: 17
}

docs {
  ℹ **ADVANCED** — Autocomplete helper that powers search filters in the UI.

  Information about fields available for searching Notifications.
}

post {
  url: {{SPACELIFT_ENDPOINT}}
  body: graphql
  auth: bearer
}

auth:bearer {
  token: {{jwt}}
}

body:graphql {
  query SearchNotificationsSuggestions($input: SearchSuggestionsInput!) {
    searchNotificationsSuggestions(input: $input) {
      filteredCount
      fields {
        name
        orderable
        filterable
        type
      }
    }
  }
}

body:graphql:vars {
  {
    "input": {}
  }
}
