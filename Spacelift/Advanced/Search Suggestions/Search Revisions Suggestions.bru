meta {
  name: Search Revisions Suggestions
  type: graphql
  seq: 22
}

docs {
  ℹ **ADVANCED** — Autocomplete helper that powers search filters in the UI.

  Get field suggestions for Revision search
}

post {
  url: {{SPACELIFT_ENDPOINT}}
  body: graphql
  auth: inherit
}

body:graphql {
  query SearchRevisionsSuggestions($repoID: ID!, $input: SearchSuggestionsInput!) {
    searchRevisionsSuggestions(repoID: $repoID, input: $input) {
      filteredCount
      fields {
        name
        orderable
        filterable
        type
      }
    }
  }
}

body:graphql:vars {
  {
    "repoID": "REPO_ID_HERE",
    "input": {}
  }
}
