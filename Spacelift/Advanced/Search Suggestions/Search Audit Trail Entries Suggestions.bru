meta {
  name: Search Audit Trail Entries Suggestions
  type: graphql
  seq: 7
}

docs {
  ℹ **ADVANCED** — Autocomplete helper that powers search filters in the UI.

  Information about fields available for searching audit trail entries.
}

post {
  url: {{SPACELIFT_ENDPOINT}}
  body: graphql
  auth: inherit
}

body:graphql {
  query SearchAuditTrailEntriesSuggestions($input: SearchSuggestionsInput!) {
    searchAuditTrailEntriesSuggestions(input: $input) {
      filteredCount
      fields {
        name
        orderable
        filterable
        type
      }
    }
  }
}

body:graphql:vars {
  {
    "input": {}
  }
}
