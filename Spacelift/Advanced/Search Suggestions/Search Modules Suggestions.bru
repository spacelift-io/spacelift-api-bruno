meta {
  name: Search Modules Suggestions
  type: graphql
  seq: 15
}

docs {
  ℹ **ADVANCED** — Autocomplete helper that powers search filters in the UI.

  Information about fields available for searching Modules.
}

post {
  url: {{SPACELIFT_ENDPOINT}}
  body: graphql
  auth: inherit
}

body:graphql {
  query SearchModulesSuggestions($input: SearchSuggestionsInput!) {
    searchModulesSuggestions(input: $input) {
      filteredCount
      fields {
        name
        orderable
        filterable
        type
      }
    }
  }
}

body:graphql:vars {
  {
    "input": {}
  }
}
