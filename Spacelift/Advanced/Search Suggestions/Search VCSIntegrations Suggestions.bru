meta {
  name: Search VCSIntegrations Suggestions
  type: graphql
  seq: 29
}

docs {
  ℹ **ADVANCED** — Autocomplete helper that powers search filters in the UI.
}

post {
  url: {{SPACELIFT_ENDPOINT}}
  body: graphql
  auth: inherit
}

body:graphql {
  query SearchVCSIntegrationsSuggestions($input: SearchSuggestionsInput!) {
    searchVCSIntegrationsSuggestions(input: $input) {
      filteredCount
      fields {
        name
        orderable
        filterable
        type
      }
    }
  }
}

body:graphql:vars {
  {
    "input": {}
  }
}
