meta {
  name: Billing Subscription
  type: graphql
  seq: 4
}

docs {
  ℹ **ADVANCED** — Subscription and billing management, normally handled through Spacelift sales.

  Shows Stripe Billing subscription details
}

post {
  url: {{SPACELIFT_ENDPOINT}}
  body: graphql
  auth: inherit
}

body:graphql {
  query BillingSubscription {
    billingSubscription {
      billingCycleStart
      billingRenewalDate
      billingInterval
      billingAmount
      isActive
      selfServePortalUrl
    }
  }
}

body:graphql:vars {
  {}
}
