meta {
  name: Seats
  type: graphql
  seq: 11
}

docs {
  ℹ **ADVANCED** — Subscription and billing management, normally handled through Spacelift sales.

  Returns the seat limits and the number of in-use seats.
}

post {
  url: {{SPACELIFT_ENDPOINT}}
  body: graphql
  auth: inherit
}

body:graphql {
  query Seats {
    seats {
      apiKey {
        limit
        inUse
      }
      user {
        limit
        inUse
      }
    }
  }
}

body:graphql:vars {
  {}
}
