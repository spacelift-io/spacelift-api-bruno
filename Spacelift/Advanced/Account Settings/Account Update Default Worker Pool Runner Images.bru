meta {
  name: Account Update Default Worker Pool Runner Images
  type: graphql
  seq: 17
}

docs {
  ℹ **ADVANCED** — Account-wide administrative setting.

  Update Account's default public worker pool runner image
}

post {
  url: {{SPACELIFT_ENDPOINT}}
  body: graphql
  auth: inherit
}

body:graphql {
  mutation AccountUpdateDefaultWorkerPoolRunnerImages {
    accountUpdateDefaultWorkerPoolRunnerImages {
      privateWorkerPoolRunnerImage
      publicWorkerPoolRunnerImage
    }
  }
}

