meta {
  name: Account Set Infra Assistant Enabled
  type: graphql
  seq: 7
}

docs {
  ℹ **ADVANCED** — Account-wide administrative setting.

  Set Infra Assistant enabled state. Requires T&C to be accepted first.
}

post {
  url: {{SPACELIFT_ENDPOINT}}
  body: graphql
  auth: inherit
}

body:graphql {
  mutation AccountSetInfraAssistantEnabled($enabled: Boolean!) {
    accountSetInfraAssistantEnabled(enabled: $enabled)
  }
}

body:graphql:vars {
  {
    "enabled": false
  }
}
