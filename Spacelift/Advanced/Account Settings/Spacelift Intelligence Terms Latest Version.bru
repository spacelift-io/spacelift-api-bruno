meta {
  name: Spacelift Intelligence Terms Latest Version
  type: graphql
  seq: 40
}

docs {
  ℹ **ADVANCED** — Account-wide administrative setting.

  SpaceliftIntelligenceTermsLatestVersion returns the latest version of the Spacelift Intelligence terms and conditions.
}

post {
  url: {{SPACELIFT_ENDPOINT}}
  body: graphql
  auth: inherit
}

body:graphql {
  query SpaceliftIntelligenceTermsLatestVersion {
    spaceliftIntelligenceTermsLatestVersion {
      content
      version
    }
  }
}

body:graphql:vars {
  {}
}
