meta {
  name: Spacelift Intelligence Enabled
  type: graphql
  seq: 38
}

docs {
  ℹ **ADVANCED** — Account-wide administrative setting.

  SpaceliftIntelligenceEnabled determines whether Spacelift Intelligence is enabled for the account (true if any sub-feature is on).
}

post {
  url: {{SPACELIFT_ENDPOINT}}
  body: graphql
  auth: inherit
}

body:graphql {
  query SpaceliftIntelligenceEnabled {
    spaceliftIntelligenceEnabled
  }
}

body:graphql:vars {
  {}
}
