meta {
  name: Account Set Infra Assistant Build Mode Enabled
  type: graphql
  seq: 6
}

docs {
  ℹ **ADVANCED** — Account-wide administrative setting.

  Set Infra Assistant build mode enabled state. Requires T&C to be accepted first.
}

post {
  url: {{SPACELIFT_ENDPOINT}}
  body: graphql
  auth: inherit
}

body:graphql {
  mutation AccountSetInfraAssistantBuildModeEnabled($enabled: Boolean!) {
    accountSetInfraAssistantBuildModeEnabled(enabled: $enabled)
  }
}

body:graphql:vars {
  {
    "enabled": false
  }
}
