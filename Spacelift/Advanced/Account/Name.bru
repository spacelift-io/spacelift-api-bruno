meta {
  name: Name
  type: graphql
  seq: 2
}

docs {
  ℹ **ADVANCED** — Account-level scalar exposed as a root query field.

  Name of the account.
}

post {
  url: {{SPACELIFT_ENDPOINT}}
  body: graphql
  auth: bearer
}

auth:bearer {
  token: {{jwt}}
}

body:graphql {
  query Name {
    name
  }
}

body:graphql:vars {
  {}
}
