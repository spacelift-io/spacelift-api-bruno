meta {
  name: Is Generic Form Completed
  type: graphql
  seq: 3
}

docs {
  ℹ **ADVANCED** — In-app survey and onboarding forms.

  Returns true if the generic form is completed
}

post {
  url: {{SPACELIFT_ENDPOINT}}
  body: graphql
  auth: inherit
}

body:graphql {
  query IsGenericFormCompleted($name: String!) {
    isGenericFormCompleted(name: $name)
  }
}

body:graphql:vars {
  {
    "name": "example"
  }
}
