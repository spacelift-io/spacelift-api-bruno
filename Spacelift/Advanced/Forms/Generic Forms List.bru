meta {
  name: Generic Forms List
  type: graphql
  seq: 2
}

docs {
  ℹ **ADVANCED** — In-app survey and onboarding forms.

  Returns a list of available generic forms
}

post {
  url: {{SPACELIFT_ENDPOINT}}
  body: graphql
  auth: inherit
}

body:graphql {
  query GenericFormsList {
    genericFormsList {
      name
      properties
    }
  }
}

body:graphql:vars {
  {}
}
