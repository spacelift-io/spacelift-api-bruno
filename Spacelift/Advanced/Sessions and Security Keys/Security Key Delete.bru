meta {
  name: Security Key Delete
  type: graphql
  seq: 2
}

docs {
  ℹ **ADVANCED** — Manages your own sessions and security keys.

  Delete a security key.
}

post {
  url: {{SPACELIFT_ENDPOINT}}
  body: graphql
  auth: inherit
}

body:graphql {
  mutation SecurityKeyDelete($id: ID!) {
    securityKeyDelete(id: $id) {
      id
      createdAt
      currentOwner
      name
      owner
    }
  }
}

body:graphql:vars {
  {
    "id": "ID_HERE"
  }
}
