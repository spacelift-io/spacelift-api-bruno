meta {
  name: Dismiss All Notifications
  type: graphql
  seq: 1
}

docs {
  ℹ **ADVANCED** — Manages the in-app notification inbox.

  Dismisses all notifications.
}

post {
  url: {{SPACELIFT_ENDPOINT}}
  body: graphql
  auth: inherit
}

body:graphql {
  mutation DismissAllNotifications {
    dismissAllNotifications
  }
}

