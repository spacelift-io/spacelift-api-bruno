meta {
  name: Dismiss Notifications
  type: graphql
  seq: 3
}

docs {
  ℹ **ADVANCED** — Manages the in-app notification inbox.

  Dismisses notifications.
}

post {
  url: {{SPACELIFT_ENDPOINT}}
  body: graphql
  auth: bearer
}

auth:bearer {
  token: {{jwt}}
}

body:graphql {
  mutation DismissNotifications($ids: [ID!]!) {
    dismissNotifications(ids: $ids) {
      id
      title
      body
      dismissed
      severity
      timestamp
    }
  }
}

body:graphql:vars {
  {
    "ids": [
      "IDS_ID_HERE"
    ]
  }
}
