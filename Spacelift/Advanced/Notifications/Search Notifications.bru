meta {
  name: Search Notifications
  type: graphql
  seq: 5
}

docs {
  ℹ **ADVANCED** — Manages the in-app notification inbox.

  Search Notifications with a set of predicates, ordering and paging.
}

post {
  url: {{SPACELIFT_ENDPOINT}}
  body: graphql
  auth: inherit
}

body:graphql {
  query SearchNotifications($input: SearchInput!) {
    searchNotifications(input: $input) {
      edges {
        cursor
      }
      pageInfo {
        endCursor
        startCursor
        hasNextPage
        hasPreviousPage
      }
    }
  }
}

body:graphql:vars {
  {
    "input": {}
  }
}
