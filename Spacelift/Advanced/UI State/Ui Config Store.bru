meta {
  name: Ui Config Store
  type: graphql
  seq: 2
}

docs {
  ℹ **ADVANCED** — Stores in-app UI preferences.

  Upload a persistent UI config. Consecutive calls will overwrite the previous config.
  UI config is a JSON blob.
}

post {
  url: {{SPACELIFT_ENDPOINT}}
  body: graphql
  auth: bearer
}

auth:bearer {
  token: {{jwt}}
}

body:graphql {
  mutation UiConfigStore($input: String!) {
    uiConfigStore(input: $input)
  }
}

body:graphql:vars {
  {
    "input": "example"
  }
}
