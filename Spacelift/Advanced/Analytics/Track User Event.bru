meta {
  name: Track User Event
  type: graphql
  seq: 4
}

docs {
  ℹ **ADVANCED** — Client-side tracking event, normally emitted by the Spacelift UI rather than called directly.

  Track user event
}

post {
  url: {{SPACELIFT_ENDPOINT}}
  body: graphql
  auth: bearer
}

auth:bearer {
  token: {{jwt}}
}

body:graphql {
  mutation TrackUserEvent {
    trackUserEvent
  }
}

body:graphql:vars {
  {}
}
