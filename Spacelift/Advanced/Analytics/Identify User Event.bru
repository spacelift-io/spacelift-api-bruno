meta {
  name: Identify User Event
  type: graphql
  seq: 2
}

docs {
  ℹ **ADVANCED** — Client-side tracking event, normally emitted by the Spacelift UI rather than called directly.

  Identify user event
}

post {
  url: {{SPACELIFT_ENDPOINT}}
  body: graphql
  auth: inherit
}

body:graphql {
  mutation IdentifyUserEvent {
    identifyUserEvent
  }
}

body:graphql:vars {
  {}
}
