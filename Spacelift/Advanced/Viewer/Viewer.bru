meta {
  name: Viewer
  type: graphql
  seq: 1
}

docs {
  ℹ **ADVANCED** — Returns the currently authenticated user.

  Current user, if any.

  <!-- notes: hand-written, preserved by sync-docs -->

  The fastest way to check that a token works and to see what it is allowed to do.
  Worth sending first when a request fails with a permission error, to tell
  "the token is wrong" apart from "the token lacks this permission".
}

post {
  url: {{SPACELIFT_ENDPOINT}}
  body: graphql
  auth: inherit
}

body:graphql {
  query Viewer {
    viewer {
      id
      admin
      canCreatePersonalApiKey
      avatarURL
      email
      jwt
    }
  }
}

body:graphql:vars {
  {}
}

example {
  name: Example response
  description: Illustrative, generated from the schema — not captured from a live account. The shape and field names are exact; the values are placeholders.

  request: {
    url: {{SPACELIFT_ENDPOINT}}
    method: POST
    mode: graphql
    body:graphql: {
      query Viewer {
        viewer {
          id
          admin
          canCreatePersonalApiKey
          avatarURL
          email
