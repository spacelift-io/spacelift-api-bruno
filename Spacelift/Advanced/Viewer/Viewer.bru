        {
          "data": {
            "viewer": {
              "id": "example-user",
              "admin": true,
              "canCreatePersonalApiKey": true,
              "avatarURL": "https://example.com",
              "email": "someone@example.com",
              "jwt": "example-token"
            }
          }
        }
      '''
