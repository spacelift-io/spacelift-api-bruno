meta {
  name: Search Intent Projects Suggestions
  type: graphql
  seq: 28
}

docs {
  ℹ **ADVANCED** — Intent and AI chat preview feature.
}

post {
  url: {{SPACELIFT_ENDPOINT}}
  body: graphql
  auth: bearer
}

auth:bearer {
  token: {{jwt}}
}

body:graphql {
  query SearchIntentProjectsSuggestions($input: SearchSuggestionsInput!) {
    searchIntentProjectsSuggestions(input: $input) {
      filteredCount
      fields {
        name
        orderable
        filterable
        type
      }
    }
  }
}

body:graphql:vars {
  {
    "input": {}
  }
}
