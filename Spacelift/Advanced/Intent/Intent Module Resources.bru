meta {
  name: Intent Module Resources
  type: graphql
  seq: 6
}

docs {
  ℹ **ADVANCED** — Intent and AI chat preview feature.

  Returns the underlying terraform-managed resources for a spacelift/module
  intent resource by walking its terraform state. Data sources are excluded.
  Cursor-paginated with first/after; at most 50 resources per page.
}

post {
  url: {{SPACELIFT_ENDPOINT}}
  body: graphql
  auth: bearer
}

auth:bearer {
  token: {{jwt}}
}

body:graphql {
  query IntentModuleResources($intentProjectID: ID!, $resourceID: ID!) {
    intentModuleResources(intentProjectID: $intentProjectID, resourceID: $resourceID) {
      edges {
        cursor
      }
      pageInfo {
        endCursor
        startCursor
        hasNextPage
        hasPreviousPage
      }
    }
  }
}

body:graphql:vars {
  {
    "intentProjectID": "INTENT_PROJECT_ID_HERE",
    "resourceID": "RESOURCE_ID_HERE"
  }
}
