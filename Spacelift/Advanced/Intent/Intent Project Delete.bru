meta {
  name: Intent Project Delete
  type: graphql
  seq: 16
}

docs {
  ℹ **ADVANCED** — Intent and AI chat preview feature.
}

post {
  url: {{SPACELIFT_ENDPOINT}}
  body: graphql
  auth: inherit
}

body:graphql {
  mutation IntentProjectDelete($id: ID!) {
    intentProjectDelete(id: $id) {
      allowedActions
      id
      name
      description
      labels
      createdAt
    }
  }
}

body:graphql:vars {
  {
    "id": "{{?Intent Project ID}}"
  }
}
