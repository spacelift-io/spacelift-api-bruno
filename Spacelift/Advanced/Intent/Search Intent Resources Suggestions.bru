meta {
  name: Search Intent Resources Suggestions
  type: graphql
  seq: 32
}

docs {
  ℹ **ADVANCED** — Intent and AI chat preview feature.
}

post {
  url: {{SPACELIFT_ENDPOINT}}
  body: graphql
  auth: bearer
}

auth:bearer {
  token: {{jwt}}
}

body:graphql {
  query SearchIntentResourcesSuggestions($input: SearchSuggestionsInput!) {
    searchIntentResourcesSuggestions(input: $input) {
      filteredCount
      fields {
        name
        orderable
        filterable
        type
      }
    }
  }
}

body:graphql:vars {
  {
    "input": {}
  }
}
