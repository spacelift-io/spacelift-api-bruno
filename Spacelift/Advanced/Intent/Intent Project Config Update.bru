meta {
  name: Intent Project Config Update
  type: graphql
  seq: 14
}

docs {
  ℹ **ADVANCED** — Intent and AI chat preview feature.
}

post {
  url: {{SPACELIFT_ENDPOINT}}
  body: graphql
  auth: inherit
}

body:graphql {
  mutation IntentProjectConfigUpdate($project: ID!, $config: ConfigInput!) {
    intentProjectConfigUpdate(project: $project, config: $config) {
      id
      checksum
      createdAt
      runtime
      type
      value
    }
  }
}

body:graphql:vars {
  {
    "project": "PROJECT_ID_HERE",
    "config": {
      "id": "ID_HERE",
      "type": "ENVIRONMENT_VARIABLE",
      "value": "example",
      "writeOnly": false
    }
  }
}
