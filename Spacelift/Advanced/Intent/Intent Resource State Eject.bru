meta {
  name: Intent Resource State Eject
  type: graphql
  seq: 26
}

docs {
  ℹ **ADVANCED** — Intent and AI chat preview feature.
}

post {
  url: {{SPACELIFT_ENDPOINT}}
  body: graphql
  auth: inherit
}

body:graphql {
  mutation IntentResourceStateEject($intentProject: ID!, $resourceID: String!) {
    intentResourceStateEject(intentProject: $intentProject, resourceID: $resourceID) {
      resourceID
      intentProjectID
      resourceType
      address
      name
      provider
    }
  }
}

body:graphql:vars {
  {
    "intentProject": "{{?Intent Project ID}}",
    "resourceID": "example"
  }
}
