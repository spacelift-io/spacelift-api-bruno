meta {
  name: Debug Info
  type: graphql
  seq: 1
}

docs {
  ℹ **ADVANCED** — Internal diagnostic field.

  Info about git build related data, self-hosted licence. Not valid in SaaS.
}

post {
  url: {{SPACELIFT_ENDPOINT}}
  body: graphql
  auth: inherit
}

body:graphql {
  query DebugInfo {
    debugInfo {
      commitSha
      selfHostedVersion
    }
  }
}

body:graphql:vars {
  {}
}
