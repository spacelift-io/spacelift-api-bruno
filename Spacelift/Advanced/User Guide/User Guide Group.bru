meta {
  name: User Guide Group
  type: graphql
  seq: 12
}

docs {
  ℹ **ADVANCED** — Drives the in-app onboarding wizard.

  Retrieve a single user guide group by ID
}

post {
  url: {{SPACELIFT_ENDPOINT}}
  body: graphql
  auth: bearer
}

auth:bearer {
  token: {{jwt}}
}

body:graphql {
  query UserGuideGroup($id: ID!) {
    userGuideGroup(id: $id) {
      id
      order
      name
      description
      skillLevel
      requiredEntitlements
    }
  }
}

body:graphql:vars {
  {
    "id": "ID_HERE"
  }
}
