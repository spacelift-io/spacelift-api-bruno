meta {
  name: User Guides
  type: graphql
  seq: 18
}

docs {
  ℹ **ADVANCED** — Drives the in-app onboarding wizard.

  List all available user guides
}

post {
  url: {{SPACELIFT_ENDPOINT}}
  body: graphql
  auth: inherit
}

body:graphql {
  query UserGuides {
    userGuides {
      id
      order
      slug
      groupId
    }
  }
}

body:graphql:vars {
  {}
}
