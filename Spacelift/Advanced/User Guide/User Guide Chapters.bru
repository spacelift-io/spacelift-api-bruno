meta {
  name: User Guide Chapters
  type: graphql
  seq: 10
}

docs {
  ℹ **ADVANCED** — Drives the in-app onboarding wizard.

  List all user guide chapters
}

post {
  url: {{SPACELIFT_ENDPOINT}}
  body: graphql
  auth: inherit
}

body:graphql {
  query UserGuideChapters {
    userGuideChapters {
      id
      order
      name
      description
    }
  }
}

body:graphql:vars {
  {}
}
