meta {
  name: User Guide Restart
  type: graphql
  seq: 16
}

docs {
  ℹ **ADVANCED** — Drives the in-app onboarding wizard.

  Restart a user guide from step 0 while preserving completion history
}

post {
  url: {{SPACELIFT_ENDPOINT}}
  body: graphql
  auth: bearer
}

auth:bearer {
  token: {{jwt}}
}

body:graphql {
  mutation UserGuideRestart($id: ID!) {
    userGuideRestart(id: $id) {
      status
      startedAt
      completedAt
      currentStep
      progressPercent
    }
  }
}

body:graphql:vars {
  {
    "id": "ID_HERE"
  }
}
