meta {
  name: User Guide Complete
  type: graphql
  seq: 11
}

docs {
  ℹ **ADVANCED** — Drives the in-app onboarding wizard.

  Complete the active user guide
}

post {
  url: {{SPACELIFT_ENDPOINT}}
  body: graphql
  auth: bearer
}

auth:bearer {
  token: {{jwt}}
}

body:graphql {
  mutation UserGuideComplete {
    userGuideComplete {
      status
      startedAt
      completedAt
      currentStep
      progressPercent
    }
  }
}

body:graphql:vars {
  {}
}
