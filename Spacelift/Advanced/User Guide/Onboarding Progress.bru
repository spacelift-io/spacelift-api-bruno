meta {
  name: Onboarding Progress
  type: graphql
  seq: 3
}

docs {
  ℹ **ADVANCED** — Drives the in-app onboarding wizard.

  Onboarding progress for all users on the account
}

post {
  url: {{SPACELIFT_ENDPOINT}}
  body: graphql
  auth: inherit
}

body:graphql {
  query OnboardingProgress {
    onboardingProgress {
      userLogin
      percentage
    }
  }
}

body:graphql:vars {
  {}
}
