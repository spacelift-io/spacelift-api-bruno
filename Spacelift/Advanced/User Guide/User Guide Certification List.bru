meta {
  name: User Guide Certification List
  type: graphql
  seq: 7
}

docs {
  ℹ **ADVANCED** — Drives the in-app onboarding wizard.

  List the calling user's certificates
}

post {
  url: {{SPACELIFT_ENDPOINT}}
  body: graphql
  auth: inherit
}

body:graphql {
  query UserGuideCertificationList {
    userGuideCertificationList {
      id
      userLogin
      displayName
      course
      issuedAt
      groupID
    }
  }
}

body:graphql:vars {
  {}
}
