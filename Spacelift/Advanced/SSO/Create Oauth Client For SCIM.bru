meta {
  name: Create Oauth Client For SCIM
  type: graphql
  seq: 1
}

docs {
  ℹ **ADVANCED** — Account-level SSO, SAML, SCIM or OIDC configuration.

  Create an OAuth2 client for SCIM provisioning
}

post {
  url: {{SPACELIFT_ENDPOINT}}
  body: graphql
  auth: inherit
}

body:graphql {
  mutation CreateOauthClientForSCIM {
    createOauthClientForSCIM {
      clientID
      clientSecret
      connnectorBaseURL
      accessTokenEndpoint
    }
  }
}

body:graphql:vars {
  {}
}
