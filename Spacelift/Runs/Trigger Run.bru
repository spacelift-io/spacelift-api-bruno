meta {
  name: Trigger Run
  type: graphql
  seq: 1
}

docs {
  Trigger a Run. By default, this mutation triggers a tracked run for the
  commit currently tracked by a Stack or, if the Stack is not yet tracking any
  commit, against the HEAD of the Stack's tracked branch. These defaults can
  be overridden.

  <!-- notes: hand-written, preserved by sync-docs -->

  **`runType`** accepts `PROPOSED` (plan only, nothing applied), `TRACKED` (the
  normal deployable run), `DESTROY`, `TASK`, `TESTING` and `PARSE`. Omit it for the
  stack's default.

  Leave `commitSha` null to run against whatever commit the stack currently
  tracks.

  `stack` is the stack to run, from **Stacks → List Stacks**. The `id` in the
  response is the run ID that **Confirm Run** asks for.
}

post {
  url: {{SPACELIFT_ENDPOINT}}
  body: graphql
  auth: inherit
}

body:graphql {
  mutation TriggerRun($stack: ID!, $commitSha: String, $runType: RunType) {
    runTrigger(stack: $stack, commitSha: $commitSha, runType: $runType) {
      id
      state
      type
      createdAt
      triggeredBy
    }
  }
}

body:graphql:vars {
  {
    "stack": "STACK_ID_HERE",
    "commitSha": null,
    "runType": "PROPOSED"
  }
}
