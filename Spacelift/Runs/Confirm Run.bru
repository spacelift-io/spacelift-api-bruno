meta {
  name: Confirm Run
  type: graphql
  seq: 2
}

docs {
  Confirm a Run that's waiting to be applied. If the Run ID is not passed, the
  Run that's currently blocking the stack will be confirmed.

  <!-- notes: hand-written, preserved by sync-docs -->

  Takes both IDs from the variables **List Stacks** and **Trigger Run** set, so the
  three requests run in order with no copying. Replace either with a literal ID to
  confirm a different run.

  Omit `run` entirely to confirm whichever run is currently blocking the stack.
}

post {
  url: {{SPACELIFT_ENDPOINT}}
  body: graphql
  auth: inherit
}

body:graphql {
  mutation ConfirmRun($stack: ID!, $run: ID, $note: String) {
    runConfirm(stack: $stack, run: $run, note: $note) {
      id
      state
      type
    }
  }
}

body:graphql:vars {
  {
    "stack": "{{stackId}}",
    "run": "{{runId}}",
    "note": "Approved"
  }
}
