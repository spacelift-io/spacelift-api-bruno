{
  "name": "spacelift-api-bruno",
  "description": "Bruno collection for Spacelift API",
  "private": true,
  "license": "MIT",
  "scripts": {
    "api-changelog": "node scripts/api-changelog.js",
    "collection-changelog:check": "node scripts/collection-changelog.js --check",
    "collection-changelog:collect": "node scripts/collection-changelog.js --collect",
    "collection-changelog:sync": "node scripts/collection-changelog.js --sync",
    "coverage": "node scripts/coverage.js",
    "destructive-prompts": "node scripts/destructive-prompts.js",
    "destructive-prompts:check": "node scripts/destructive-prompts.js --check",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "pre-commit:update": "pre-commit autoupdate --freeze",
    "sync-docs": "node scripts/sync-docs.js",
    "sync-docs:check": "node scripts/sync-docs.js --check",
    "sync-docs:check-folders": "node scripts/sync-docs.js --check-folders",
    "validate": "node scripts/validate-schema.js"
  },
  "dependencies": {
    "graphql": "^17.0.2"
  },
  "devDependencies": {
    "prettier": "^3.9.6"
  }
}
